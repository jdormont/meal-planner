{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/privacy/:path*",
      "destination": "/privacy/:path*"
    },
    {
      "source": "/:path*.:ext",
      "destination": "/:path*.:ext"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
